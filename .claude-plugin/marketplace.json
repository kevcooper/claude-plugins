        "name": "Kevin Cooper"
      },
      "homepage": "https://github.com/kevcooper/cheapshot",
      "category": "development",
      "keywords": [
        "mcp",
        "inference",
        "cache"
      ]
    },
    {
      "name": "redcard",
      "source": {
        "source": "github",
        "repo": "kevcooper/redcard"
      },
      "description": "Run every Claude Code hook event through your own OPA (Rego) policies: block, require approval, approve, keep Claude working, add context, and more.",
      "author": {
        "name": "Kevin Cooper"
      },
      "homepage": "https://github.com/kevcooper/redcard",
      "category": "security",
      "keywords": [
        "opa",
        "rego",
        "policy",
        "hooks",
        "security"
      ]
    }
  ]
