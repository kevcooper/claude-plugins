  "metadata": {
    "description": "Kevin Cooper's Claude Code plugins",
    "version": "0.1.0"
  },
  "plugins": [
    {
      "name": "cheapshot",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/kevcooper/cheapshot.git",
        "path": "plugins/cheapshot"
      },
      "description": "One-shot Claude inference as an MCP tool, cached locally so repeat requests are free.",
